FROM node:22-alpine

# Apply available OS security updates
RUN apk upgrade --no-cache

# Keep npm itself current
# npm 11 supports Node 22; npm@latest may require a newer Node than the image.
RUN npm install -g npm@11 && npm cache clean --force

WORKDIR /oauth-proxy-server

COPY ./oauth-proxy-server/server.js /oauth-proxy-server//
COPY ./oauth-proxy-server/package.json /oauth-proxy-server//

RUN npm install && npm cache clean --force

CMD [ "npm", "start" ]
