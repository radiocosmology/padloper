FROM node:20-alpine

# Apply available OS security updates
RUN apk upgrade --no-cache

# Keep npm current within the major that supports this image's Node 20
# (npm@latest now requires Node >= 22 and fails the build).
RUN npm install -g npm@10 && npm cache clean --force

WORKDIR /web-interface

# Install dependencies first (leverage Docker layer cache)
COPY ./web-interface/package.json /web-interface/
# If a lockfile exists, copy it too for deterministic installs
# Install deps deterministically when a lockfile is present
# RUN if [ -f package-lock.json ]; then \
#       npm ci --no-audit --no-fund; \
#     else \
#       npm install --no-audit --no-fund; \
#     fi

# Build-time env for CRA
ARG REACT_APP_GITHUB_CLIENT_ID
ARG REACT_APP_BASE_PATH
ENV REACT_APP_GITHUB_CLIENT_ID=${REACT_APP_GITHUB_CLIENT_ID}
ENV REACT_APP_BASE_PATH=${REACT_APP_BASE_PATH:-/padloper}
# There is no lockfile, so every build floats to the newest transitive
# versions; the CRA ESLint plugin currently fails with "Environment key
# jest/globals is unknown" on a fresh install. Lint is run separately
# (`npx eslint src`), so build the bundle without it.
ENV DISABLE_ESLINT_PLUGIN=true

RUN npm install

EXPOSE 4301
CMD [ "npm", "start" ]
